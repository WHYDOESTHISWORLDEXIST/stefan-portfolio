# Create a Resend API key at https://resend.com/api-keys and keep the real
# value in an ignored .env.local file or in the hosting provider's secrets.
RESEND_API_KEY=re_replace_with_your_key

# Use onboarding@resend.dev while testing. After verifying stefancutler.com
# in Resend, change this to a sender such as contact@stefancutler.com.
CONTACT_FROM_EMAIL="Stefan's Portfolio <onboarding@resend.dev>"
